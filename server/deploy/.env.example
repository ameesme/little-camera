# Your domain. Blogs live at <handle>.<DOMAIN>, registration at https://<DOMAIN>/
# DNS: an A record for DOMAIN and a wildcard A record for *.DOMAIN, both to this box.
DOMAIN=littlecamera.example

# Certificate contact and the DNS provider token for the wildcard certificate
ACME_EMAIL=you@example.com
CLOUDFLARE_API_TOKEN=

# Long random string; signs the login cookies. `openssl rand -hex 32`
SESSION_SECRET=

# Outgoing mail. Any SMTP works: smtps://user:pass@smtp.fastmail.com:465
# Leave empty and no mail is sent (they queue as "sent" and show up in the
# dev mailbox only when NODE_ENV != production).
SMTP_URL=
MAIL_FROM=Little Camera <camera@littlecamera.example>

# Timezone used for the dates under each photo
DISPLAY_TZ=Europe/Amsterdam
