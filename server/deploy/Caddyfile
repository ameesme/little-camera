{
	email {$ACME_EMAIL}
}

# Adding a path to `@app` hands away URL space the landing page owns, so mount new routes under /api or /app instead.
{$DOMAIN} {
	tls {
		dns vercel {$VERCEL_API_TOKEN}
	}
	encode gzip

	@app path /api/* /app/*
	reverse_proxy @app server:3000

	root * /srv/landing
	file_server
	handle_errors {
		respond "Little camera." 200
	}
}

# Blogs. Each one owns the root of its own subdomain, so there is nothing to
# split here; the wildcard certificate covers them all.
*.{$DOMAIN} {
	tls {
		dns vercel {$VERCEL_API_TOKEN}
	}
	encode gzip
	reverse_proxy server:3000
}
