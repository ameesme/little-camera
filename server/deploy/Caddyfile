{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://server:3000/caddy/ask
	}
}

# Adding a path to `@app` hands away URL space the landing page owns, so mount new routes under /api or /app instead.
{$DOMAIN} {
	encode gzip

	@app path /api/* /app/*
	reverse_proxy @app server:3000

	root * /srv/landing
	file_server
	handle_errors {
		respond "Little camera." 200
	}
}

# Blogs. Per-subdomain certs via TLS-ALPN, no DNS plugin needed.
*.{$DOMAIN} {
	tls {
		on_demand
	}
	encode gzip
	reverse_proxy server:3000
}
