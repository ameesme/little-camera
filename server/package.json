{
  "name": "@little-camera/server",
  "version": "0.1.0",
  "description": "Little Camera micro-blog and camera API (Hono + node:sqlite).",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm -C ../packages/pbm build",
    "test": "vitest run",
    "seed": "tsx src/seed.ts",
    "fake-camera": "tsx scripts/fake-camera.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@little-camera/pbm": "workspace:*",
    "hono": "^4.7.0",
    "jsqr": "^1.4.0",
    "nodemailer": "^7.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
