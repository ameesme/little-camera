# KiCad per-user state, python caches and editor backups
*.kicad_prl
*-backups/
*.bak
fp-info-cache
pcb/.mcp-backups/

# Generated by pcb/gen/*.py: boards, meshes and renders go, the written reports stay
pcb/out/*
!pcb/out/*.md
pcb/gen/bumper/
pcb/gen/route/
pcb/gen/jlc_ref/
pcb/gen/jlc_ref.tgz
pcb/gen/fusion/
pcb/gen/flash/
pcb/gen/fpgrab/
pcb/gen/verify/
pcb/gen/cnc/
pcb/*_drc_violations.json

# Superseded fab packages and scratch, kept on disk only
pcb/fab/_to_delete/
pcb/fab/jlcpcb/_old/
pcb/fab/jlcpcb/zip_tempfile_*
