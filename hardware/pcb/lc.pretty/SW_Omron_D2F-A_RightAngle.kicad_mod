(footprint "SW_Omron_D2F-A_RightAngle"
	(version 20240108)
	(generator "little-camera-gen")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Omron D2F with right-angled PCB terminals (-A / -A1), pin plunger. Body 12.8 x 6.5 lies on the board, plunger facing -Y. Holes 3 x 1.2 mm on 5.08 mm pitch, 3.1 mm behind the terminal face of the body (Omron en-d2f dimensions). Pad 1 = middle terminal = NO (SHUTTER); both end terminals = pad 2 = GND, so COM/NC order does not matter and -A or -A1 both fit. Terminal row assumed centred on the body length; plunger position along the body not modelled - check against the part.")
	(tags "omron d2f right angle microswitch shutter")
	(property "Reference" "REF**" (at 0 1.9 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
