(footprint "SW_Omron_D2F_PCB"
	(version 20240108)
	(generator "little-camera-gen")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Omron D2F ultra-subminiature snap-action switch, PCB terminals, 5.08 mm pitch, body 12.8 x 5.8 mm. Middle terminal is NO (confirmed on the part) and is pad 1 (SHUTTER). Both end terminals (COM and NC) are pad 2 (GND): at rest COM-NC shorts GND to GND harmlessly, pressed COM-NO pulls SHUTTER low, whichever end is COM. Through-hole: hand-fit. The +Y side of the body overhangs the board edge by ~0.6 mm in this design, so silk stops short of it.")
	(tags "omron d2f microswitch snap action shutter")
	(property "Reference" "REF**" (at 0 -4.5 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
	(property "Value" "D2F" (at 0 4.5 0) (layer "F.Fab") (hide yes) (effects (font (size 1 1) (thickness 0.15))))
