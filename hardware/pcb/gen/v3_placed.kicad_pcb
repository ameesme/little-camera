	(footprint "lc:SW_Omron_D2MQ-1-TR"
		(layer "F.Cu")
		(uuid "cf020b7d-05d8-4617-bc54-d96d392e01ad")
		(at 106 115.95)
		(descr "Omron D2MQ-1-TR ultra-slim snap-action switch, right-angled PCB terminals, pin plunger. Body 8.2 x 6.25 lies flat on the board (2.7 mm tall), plunger facing -Y, free position ~1.2 mm past the body. Three terminals on 2.5 mm pitch; terminal row assumed 1.5 mm behind the body (slotted holes give +/-0.45 mm). Pad 1 = middle terminal = NO (SHUTTER); both end terminals = pad 2 = GND, so COM/NC order and -TR/-TL mirror do not matter. Geometry from the Omron D2MQ model + datasheet notes: VERIFY against a real part before fab.")
		(tags "omron d2mq right angle microswitch shutter")
